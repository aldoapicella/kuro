{
  "name": "kuro-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:contracts": "node --import tsx --test packages/contracts/test/*.test.ts",
    "test:core": "node --import tsx --test packages/core/test/*.test.ts",
    "test:transport": "pnpm --filter @kuro/transport test",
    "test": "pnpm test:contracts && pnpm test:core && pnpm test:transport",
    "probe:host": "node scripts/probe-host.mjs",
    "test:reference": "python3 -m unittest discover -s verification -v"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
