{
  "name": "kuro-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:contracts": "node --import tsx --test packages/contracts/test/*.test.ts",
    "test:core": "node --import tsx --test packages/core/test/*.test.ts",
    "test:transport": "pnpm --filter @kuro/transport test",
    "test:ai": "pnpm --filter @kuro/ai test",
    "test": "pnpm test:contracts && pnpm test:core && pnpm test:transport && pnpm test:ai && pnpm test:desktop",
    "desktop:build": "pnpm build && pnpm --filter @kuro/desktop build",
    "desktop:demo": "pnpm desktop:build && pnpm --filter @kuro/desktop start --mode=demo",
    "desktop:integrated": "pnpm desktop:build && pnpm --filter @kuro/desktop start --mode=core-simulated",
    "desktop:real": "pnpm desktop:build && pnpm --filter @kuro/desktop start --mode=real",
    "desktop:package": "pnpm desktop:build && pnpm --filter @kuro/desktop package",
    "test:desktop": "node --import tsx --test apps/desktop/test/*.test.ts tests/integration/desktop.test.ts",
    "test:desktop:ui": "pnpm desktop:build && playwright test --config=apps/desktop/playwright.config.ts",
    "probe:host": "node scripts/probe-host.mjs",
    "test:reference": "python3 -m unittest discover -s verification -v"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
